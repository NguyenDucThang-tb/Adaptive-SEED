#!/bin/bash
# Thực nghiệm 1a: Answer-gain adaptive. Mỗi job quét 5 ngưỡng cho một arm.
#   qsub -v ARM=adaptive_pos_only run_exp1.pbs
#   qsub -v ARM=adaptive_neg_only run_exp1.pbs
#   qsub -v ARM=adaptive_pos_neg  run_exp1.pbs
# Submit từ thư mục gốc repo (có #PBS -l wd). Các job cùng WORK phải chạy nối tiếp;
# chạy song song chỉ khi mỗi worker có WORK riêng.
#PBS -P hn98
#PBS -N seed_exp1
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=160GB
#PBS -l jobfs=100GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/hn98+scratch/jp09
#PBS -l wd
#PBS -j oe

set -euo pipefail
: "${ARM:?Truyền ARM bằng qsub -v ARM=adaptive_pos_only|adaptive_neg_only|adaptive_pos_neg}"

VALUES="${VALUES:-0.25 0.5 0.75 0.9 1}"
FIXED_AP="${FIXED_AP:-0.9}"     # a_pos mặc định khi chỉ quét a_neg
FIXED_AN="${FIXED_AN:-0.25}"    # a_neg mặc định khi chỉ quét a_pos
WORK="${WORK:-/scratch/hn98/$USER/runs/exp1}"
TEACHER_FRAMES="${TEACHER_FRAMES:-32}"   # student giữ 8 frame, teacher dùng 32 frame
DISTILL_ARGS=()
if [[ -n "${DISTILL_METHODS:-}" ]]; then
  DISTILL_METHODS="${DISTILL_METHODS//:/ }"
  read -r -a DISTILL_LIST <<< "$DISTILL_METHODS"
  DISTILL_ARGS=(--distill-methods "${DISTILL_LIST[@]}")
fi
SMOKE_ARGS=()
if [[ -n "${SMOKE_PAIRS:-}" ]]; then
  SMOKE_ARGS=(--smoke-pairs "$SMOKE_PAIRS" --no-eh)
fi

module load python3/3.11.7 cuda/12.3.2
PYTHON_ENV="${PYTHON_ENV:-/scratch/hn98/$USER/venv}"
source "$PYTHON_ENV/bin/activate"

HF_HOME="${HF_HOME:-/scratch/hn98/$USER/hf_cache}"
export HF_HOME
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export SEED_CHECKPOINT_EVERY_STEPS="${SEED_CHECKPOINT_EVERY_STEPS:-5}"
export SEED_EVAL_CHECKPOINT_EVERY="${SEED_EVAL_CHECKPOINT_EVERY:-25}"
export PYTHONPATH="$PWD/src"

run_point() {
  local AP="$1" AN="$2"
  TAG="ap$(printf '%g' "$AP")_an$(printf '%g' "$AN")_tf${TEACHER_FRAMES}"
  if [[ -n "${DISTILL_METHODS:-}" ]]; then
    RESULTS="$WORK/cdt_distill_cache_f8_448/distillation_methods/runs/$TAG/results.csv"
    local missing=0 method
    for method in "${DISTILL_LIST[@]}"; do
      if ! grep -qs "^${method}@T_pos_tcd_s0," "$RESULTS"; then
        missing=1
      fi
    done
    if [[ $missing == 0 ]]; then
      echo "===== SKIP (đã xong): distill methods | $TAG ====="
      return
    fi
  else
    RESULTS="$WORK/cdt_distill_cache_f8_448/seed_component_ablation/runs/$TAG/results.csv"
    if grep -qs "^${ARM}_s0," "$RESULTS"; then
      echo "===== SKIP (đã xong): $ARM | $TAG ====="
      return
    fi
  fi
  echo "===== $ARM | a_pos=$AP a_neg=$AN | $(date) ====="
  # seed_base cùng (a_pos, a_neg) là Base_fix để so sánh công bằng.
  python -m seed_video --stage core --work-dir "$WORK" \
      --a-pos "$AP" --a-neg "$AN" --teacher-frames "$TEACHER_FRAMES" --arms seed_base "$ARM" \
      "${DISTILL_ARGS[@]}" "${SMOKE_ARGS[@]}"
}

if [[ "$ARM" == adaptive_pos_neg && -n "${PAIR:-}" ]]; then
  IFS=: read -r AP AN <<< "$PAIR"
  [[ -n "$AP" && -n "$AN" ]] || { echo "PAIR phải có dạng a_pos:a_neg"; exit 2; }
  run_point "$AP" "$AN"
elif [[ "$ARM" == adaptive_pos_neg && -n "${PAIRS:-}" ]]; then
  IFS=';' read -r -a PAIR_LIST <<< "$PAIRS"
  for PAIR_ITEM in "${PAIR_LIST[@]}"; do
    IFS=: read -r AP AN <<< "$PAIR_ITEM"
    [[ -n "$AP" && -n "$AN" ]] || { echo "Cặp không hợp lệ: $PAIR_ITEM"; exit 2; }
    run_point "$AP" "$AN"
  done
else
  for v in $VALUES; do
    case "$ARM" in
      adaptive_pos_only) AP=$v;        AN=$FIXED_AN ;;
      adaptive_neg_only) AP=$FIXED_AP; AN=$v ;;
      adaptive_pos_neg)  AP=$v;        AN=$v ;;
      *) echo "ARM không hợp lệ: $ARM"; exit 2 ;;
    esac
    run_point "$AP" "$AN"
  done
fi
