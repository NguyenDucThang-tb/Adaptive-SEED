#!/bin/bash
#PBS -j oe
set -euo pipefail
module load python3/3.11.7 cuda/12.3.2
ENV_ARCHIVE=$(python3 -c 'import json,os; print(json.load(open(os.environ["EXPERIMENT_ROOT"]+"/experiment.json"))["env_archive"])')
export HF_HUB_CACHE
HF_HUB_CACHE=$(python3 -c 'import json,os; print(json.load(open(os.environ["EXPERIMENT_ROOT"]+"/experiment.json"))["hf_cache"])')
export HF_HOME="$HF_HUB_CACHE" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS="${PBS_NCPUS:-12}"
export SEED_CHECKPOINT_EVERY_STEPS=1 SEED_EVAL_CHECKPOINT_EVERY=5
ENV_ROOT="${PBS_JOBFS:?}/env"
mkdir -p "$ENV_ROOT"
tar -xzf "$ENV_ARCHIVE" -C "$ENV_ROOT"
unset PYTHONHOME PYTHONPATH
"$ENV_ROOT/bin/python" "$ENV_ROOT/bin/conda-unpack"
"$ENV_ROOT/bin/python" -c 'import cv2; print("EOF fallback OpenCV:", cv2.__version__)'
export PATH="$ENV_ROOT/bin:$PATH" CONDA_PREFIX="$ENV_ROOT"
cd "$EXPERIMENT_ROOT/code"
"$ENV_ROOT/bin/python" -u "$RETRY_SCRIPT" \
  --root "$EXPERIMENT_ROOT" --point "$EXPERIMENT_POINT" --execute
